@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkPulse</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <style>
        *, *::before, *::after { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'DM Sans', sans-serif;
            background: #f0f4f8;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .login-shell {
            display: flex;
            width: 100%;
            max-width: 880px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 8px 40px rgba(0,0,0,0.08);
        }

        /* ── LEFT PANEL ── */
        .login-left {
            flex: 1;
            background: #1e3a5f;
            padding: 3rem 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .login-left::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1px);
            background-size: 24px 24px;
            pointer-events: none;
        }

        .login-left::after {
            content: '';
            position: absolute;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(96,165,250,0.15) 0%, transparent 70%);
            bottom: -100px;
            left: -80px;
            pointer-events: none;
        }

        .ll-content { position: relative; z-index: 1; }

        .ll-brand {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 2.75rem;
        }

        .ll-brand-icon {
            width: 36px;
            height: 36px;
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .ll-brand-icon svg { width: 18px; height: 18px; color: #ffffff; }

        .ll-brand-text {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .ll-brand-name {
            font-size: 15px;
            font-weight: 600;
            color: #ffffff;
            letter-spacing: -0.2px;
            line-height: 1;
        }

        .ll-brand-name span { color: #93c5fd; }

        .ll-brand-tag {
            font-size: 10.5px;
            color: #4a7a9b;
            font-family: 'DM Mono', monospace;
            letter-spacing: 0.3px;
            line-height: 1;
        }

        .ll-headline {
            font-size: 26px;
            font-weight: 600;
            color: #ffffff;
            line-height: 1.35;
            letter-spacing: -0.4px;
            margin: 0 0 12px;
        }

        .ll-sub {
            font-size: 13.5px;
            color: #93adc8;
            line-height: 1.65;
            margin: 0 0 2.5rem;
        }

        .ll-features { display: flex; flex-direction: column; gap: 13px; }

        .ll-feat { display: flex; align-items: center; gap: 11px; }

        .ll-feat-dot {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .ll-feat-dot svg { width: 13px; height: 13px; color: #93c5fd; }
        .ll-feat-text { font-size: 13px; color: #a8c4dd; }

        .ll-footer {
            position: relative;
            z-index: 1;
            font-size: 11px;
            color: #4a6a8a;
            font-family: 'DM Mono', monospace;
            margin-top: 2rem;
        }

        /* ── RIGHT PANEL ── */
        .login-right {
            width: 400px;
            flex-shrink: 0;
            padding: 3rem 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: #ffffff;
            position: relative;
        }

        /* ── PANELS inside right ── */
        .rp-panel { display: none; flex-direction: column; }
        .rp-panel.active { display: flex; }

        .lr-title { font-size: 20px; font-weight: 600; color: #111827; margin: 0 0 4px; letter-spacing: -0.3px; }
        .lr-sub { font-size: 13px; color: #9ca3af; margin: 0 0 2rem; }

        /* ── FORM FIELDS ── */
        .lc-field { margin-bottom: 14px; }

        .lc-label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: #9ca3af;
            margin-bottom: 6px;
        }

        .lc-input-wrap { position: relative; }

        .lc-input {
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            width: 100%;
            padding: 10px 14px;
            border-radius: 9px;
            border: 1px solid #e5e7eb;
            background: #f9fafb;
            color: #111827;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
        }

        .lc-input::placeholder { color: #d1d5db; }

        .lc-input:focus {
            border-color: #1e3a5f;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(30,58,95,0.1);
        }

        .lc-input.has-toggle { padding-right: 44px; }

        .lc-toggle-btn {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            color: #9ca3af;
            display: flex;
            align-items: center;
            transition: color 0.15s;
        }

        .lc-toggle-btn:hover { color: #374151; }
        .lc-toggle-btn svg { width: 16px; height: 16px; }

        .lc-field-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 6px;
        }

        .lc-forgot-link {
            font-size: 12px;
            color: #1e3a5f;
            font-weight: 500;
            text-decoration: none;
            cursor: pointer;
            background: none;
            border: none;
            padding: 0;
            font-family: 'DM Sans', sans-serif;
            transition: color 0.15s;
        }

        .lc-forgot-link:hover { color: #152b48; text-decoration: underline; }

        /* ── ALERTS ── */
        .lc-alert {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px 14px;
            border-radius: 9px;
            margin-bottom: 1.25rem;
            font-size: 13px;
        }

        .lc-alert svg { width: 15px; height: 15px; flex-shrink: 0; }

        .lc-alert.error   { background: #FCEBEB; border: 1px solid #F09595; color: #A32D2D; }
        .lc-alert.error svg { color: #ef4444; }
        .lc-alert.success { background: #EAF3DE; border: 1px solid #97C459; color: #3B6D11; }
        .lc-alert.success svg { color: #22c55e; }
        .lc-alert.info    { background: #E6F1FB; border: 1px solid #85B7EB; color: #0C447C; }
        .lc-alert.info svg { color: #185FA5; }

        /* ── DIVIDER ── */
        .lc-divider { height: 1px; background: #f0f0f0; margin: 1.25rem 0; }

        /* ── BUTTONS ── */
        .lc-submit {
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            font-weight: 600;
            width: 100%;
            padding: 11px;
            border-radius: 9px;
            border: none;
            background: #1e3a5f;
            color: #ffffff;
            cursor: pointer;
            transition: all 0.15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .lc-submit svg { width: 15px; height: 15px; }
        .lc-submit:hover { background: #152b48; }
        .lc-submit:active { transform: scale(0.99); }
        .lc-submit:disabled { background: #93adc8; cursor: not-allowed; transform: none; }

        .lc-back-btn {
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            font-weight: 500;
            background: none;
            border: 1px solid #e5e7eb;
            border-radius: 9px;
            padding: 9px 16px;
            color: #374151;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.15s;
            margin-bottom: 1.5rem;
            text-decoration: none;
        }

        .lc-back-btn svg { width: 14px; height: 14px; }
        .lc-back-btn:hover { background: #f3f4f6; border-color: #d1d5db; }

        /* ── PASSWORD CRITERIA ── */
        .lc-criteria {
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 9px;
            padding: 12px 14px;
            margin-top: 8px;
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .lc-criteria-title {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: #9ca3af;
            margin: 0 0 2px;
        }

        .lc-rule {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12.5px;
            color: #6b7280;
            transition: color 0.2s;
        }

        .lc-rule.met  { color: #16a34a; }
        .lc-rule.fail { color: #ef4444; }

        .lc-rule-icon {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 1.5px solid #d1d5db;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all 0.2s;
        }

        .lc-rule.met  .lc-rule-icon { background: #dcfce7; border-color: #22c55e; }
        .lc-rule.fail .lc-rule-icon { background: #fee2e2; border-color: #ef4444; }
        .lc-rule-icon svg { width: 10px; height: 10px; }

        .lc-match-hint {
            font-size: 12px;
            margin-top: 5px;
            font-weight: 500;
            min-height: 16px;
            display: block;
        }

        .lc-match-hint.ok   { color: #16a34a; }
        .lc-match-hint.fail { color: #ef4444; }

        /* ── REGISTER LINK ── */
        .lc-register { text-align: center; font-size: 13px; color: #9ca3af; margin-top: 1.25rem; }
        .lc-register a { color: #1e3a5f; text-decoration: none; font-weight: 500; }
        .lc-register a:hover { color: #152b48; text-decoration: underline; }

        /* ── STEP INDICATOR ── */
        .lc-steps {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 1.75rem;
        }

        .lc-step {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: #9ca3af;
            font-weight: 500;
        }

        .lc-step-num {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            border: 1.5px solid #d1d5db;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
            font-family: 'DM Mono', monospace;
            color: #9ca3af;
            flex-shrink: 0;
        }

        .lc-step.active .lc-step-num { background: #1e3a5f; border-color: #1e3a5f; color: #ffffff; }
        .lc-step.done   .lc-step-num { background: #EAF3DE; border-color: #22c55e; color: #16a34a; }
        .lc-step.active { color: #1e3a5f; }
        .lc-step.done   { color: #16a34a; }

        .lc-step-line { flex: 1; height: 1px; background: #e5e7eb; }
        .lc-step-line.done { background: #22c55e; }

        @@media (max-width: 700px) {
            .login-shell { flex-direction: column; max-width: 420px; }
            .login-left  { padding: 2rem 1.75rem 1.75rem; }
            .ll-features { display: none; }
            .ll-headline { font-size: 20px; margin-bottom: 6px; }
            .ll-sub      { margin-bottom: 0; font-size: 13px; }
            .ll-footer   { display: none; }
            .login-right { width: 100%; padding: 2rem 1.75rem; }
        }
    </style>
</head>

<body>

<div class="login-shell">

    <!-- ── LEFT PANEL ── -->
    <div class="login-left">
        <div class="ll-content">

            <!-- Brand -->
            <div class="ll-brand">
                <div class="ll-brand-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                        <path d="M8 21h8M12 17v4"/>
                    </svg>
                </div>
                <div class="ll-brand-text">
                    <span class="ll-brand-name">Work<span>Pulse</span></span>
                    <span class="ll-brand-tag">Feel the rhythm of your work.</span>
                </div>
            </div>

            <h1 class="ll-headline">Track your work.<br/>Stay consistent.</h1>
            <p class="ll-sub">Log your daily work status, manage entries,<br/>and keep your team in sync — all in one place.</p>

            <div class="ll-features">
                <div class="ll-feat">
                    <div class="ll-feat-dot">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    <span class="ll-feat-text">Daily status logging in seconds</span>
                </div>
                <div class="ll-feat">
                    <div class="ll-feat-dot">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    <span class="ll-feat-text">Edit and manage past entries</span>
                </div>
                <div class="ll-feat">
                    <div class="ll-feat-dot">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    <span class="ll-feat-text">Employee profile management</span>
                </div>
                <div class="ll-feat">
                    <div class="ll-feat-dot">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    <span class="ll-feat-text">Secure session-based access</span>
                </div>
            </div>

        </div>
        <div class="ll-footer">WorkPulse &copy; @DateTime.Now.Year</div>
    </div>

    <!-- ── RIGHT PANEL ── -->
    <div class="login-right">

        <!-- ══ PANEL 1: LOGIN ══ -->
        <div class="rp-panel active" id="panelLogin">

            <p class="lr-title">Welcome back</p>
            <p class="lr-sub">Sign in to your employee account</p>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="lc-alert error">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    @ViewBag.ErrorMessage
                </div>
            }

            @if (ViewBag.ResetSuccess != null)
            {
                <div class="lc-alert success">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    @ViewBag.ResetSuccess
                </div>
            }

            <form method="post" asp-action="Login">

                <div class="lc-field">
                    <label class="lc-label">Username</label>
                    <div class="lc-input-wrap">
                        <input type="text" name="username" class="lc-input"
                               placeholder="Enter your username" required autocomplete="username" />
                    </div>
                </div>

                <div class="lc-field">
                    <div class="lc-field-row">
                        <label class="lc-label" style="margin-bottom:0;">Password</label>
                        <button type="button" class="lc-forgot-link"
                                onclick="showPanel('panelForgotStep1')">
                            Forgot password?
                        </button>
                    </div>
                    <div class="lc-input-wrap">
                        <input type="password" id="passwordInput" name="password"
                               class="lc-input has-toggle" placeholder="••••••••"
                               required autocomplete="current-password" />
                        <button type="button" class="lc-toggle-btn"
                                onclick="togglePassword('passwordInput','eyeLogin')">
                            <svg id="eyeLogin" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="lc-divider"></div>

                <button type="submit" class="lc-submit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    Sign in
                </button>

                <div class="lc-register">
                    New here? <a asp-action="Register">Create an account</a>
                </div>

            </form>
        </div>

        <!-- ══ PANEL 2: FORGOT — Step 1 ══ -->
        <div class="rp-panel" id="panelForgotStep1">

            <button type="button" class="lc-back-btn" onclick="showPanel('panelLogin')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Back to sign in
            </button>

            <div class="lc-steps">
                <div class="lc-step active">
                    <div class="lc-step-num">1</div>
                    Verify username
                </div>
                <div class="lc-step-line"></div>
                <div class="lc-step">
                    <div class="lc-step-num">2</div>
                    New password
                </div>
                <div class="lc-step-line"></div>
                <div class="lc-step">
                    <div class="lc-step-num">3</div>
                    Done
                </div>
            </div>

            <p class="lr-title">Reset password</p>
            <p class="lr-sub">Enter your username to continue</p>

            <div id="step1Error"></div>

            <div class="lc-field">
                <label class="lc-label">Username</label>
                <div class="lc-input-wrap">
                    <input type="text" id="resetUsername" class="lc-input"
                           placeholder="Enter your username" autocomplete="username" />
                </div>
            </div>

            <div class="lc-divider"></div>

            <button type="button" class="lc-submit" onclick="verifyUsername()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="10 17 15 12 10 7"/>
                    <line x1="15" y1="12" x2="3" y2="12"/>
                </svg>
                Continue
            </button>

        </div>

        <!-- ══ PANEL 3: FORGOT — Step 2 ══ -->
        <div class="rp-panel" id="panelForgotStep2">

            <button type="button" class="lc-back-btn" onclick="showPanel('panelForgotStep1')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Back
            </button>

            <div class="lc-steps">
                <div class="lc-step done">
                    <div class="lc-step-num">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round" style="width:10px;height:10px;">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    Verify username
                </div>
                <div class="lc-step-line done"></div>
                <div class="lc-step active">
                    <div class="lc-step-num">2</div>
                    New password
                </div>
                <div class="lc-step-line"></div>
                <div class="lc-step">
                    <div class="lc-step-num">3</div>
                    Done
                </div>
            </div>

            <p class="lr-title">New password</p>
            <p class="lr-sub">Choose a strong password for your account</p>

            <div id="step2Error"></div>

            <div class="lc-field">
                <label class="lc-label">New Password</label>
                <div class="lc-input-wrap">
                    <input type="password" id="newPassword" class="lc-input has-toggle"
                           placeholder="••••••••" oninput="onNewPasswordInput(this.value)" />
                    <button type="button" class="lc-toggle-btn"
                            onclick="togglePassword('newPassword','eyeNew')">
                        <svg id="eyeNew" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>

                <div class="lc-criteria">
                    <p class="lc-criteria-title">Password must contain</p>
                    <div class="lc-rule" id="r-case">
                        <div class="lc-rule-icon">
                            <svg id="ri-case" viewBox="0 0 24 24" fill="none" stroke="#d1d5db"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </div>
                        At least 1 uppercase and 1 lowercase letter
                    </div>
                    <div class="lc-rule" id="r-num">
                        <div class="lc-rule-icon">
                            <svg id="ri-num" viewBox="0 0 24 24" fill="none" stroke="#d1d5db"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </div>
                        At least 1 number (0–9)
                    </div>
                    <div class="lc-rule" id="r-special">
                        <div class="lc-rule-icon">
                            <svg id="ri-special" viewBox="0 0 24 24" fill="none" stroke="#d1d5db"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </div>
                        At least 1 special character (!&#64;#$%^&amp;*)
                    </div>
                    <div class="lc-rule" id="r-len">
                        <div class="lc-rule-icon">
                            <svg id="ri-len" viewBox="0 0 24 24" fill="none" stroke="#d1d5db"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </div>
                        Minimum 8 characters
                    </div>
                </div>
            </div>

            <div class="lc-field">
                <label class="lc-label">Confirm New Password</label>
                <div class="lc-input-wrap">
                    <input type="password" id="confirmNewPassword" class="lc-input has-toggle"
                           placeholder="••••••••" oninput="onConfirmNewInput(this.value)" />
                    <button type="button" class="lc-toggle-btn"
                            onclick="togglePassword('confirmNewPassword','eyeConfirm')">
                        <svg id="eyeConfirm" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <span class="lc-match-hint" id="matchHint"></span>
            </div>

            <div class="lc-divider"></div>

            <button type="button" class="lc-submit" id="resetSubmitBtn"
                    onclick="submitReset()" disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                Reset password
            </button>

        </div>

        <!-- ══ PANEL 4: SUCCESS ══ -->
        <div class="rp-panel" id="panelForgotDone">

            <div style="text-align:center;padding:1rem 0 1.5rem;">
                <div style="width:56px;height:56px;background:#EAF3DE;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#22c55e"
                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                </div>
                <p style="font-size:18px;font-weight:600;color:#111827;margin:0 0 6px;">Password reset!</p>
                <p style="font-size:13px;color:#9ca3af;margin:0 0 2rem;">Your password has been updated successfully.</p>
            </div>

            <div class="lc-steps" style="margin-bottom:1.5rem;">
                <div class="lc-step done">
                    <div class="lc-step-num">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round" style="width:10px;height:10px;">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    Verify username
                </div>
                <div class="lc-step-line done"></div>
                <div class="lc-step done">
                    <div class="lc-step-num">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round" style="width:10px;height:10px;">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    New password
                </div>
                <div class="lc-step-line done"></div>
                <div class="lc-step done">
                    <div class="lc-step-num">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round" style="width:10px;height:10px;">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    Done
                </div>
            </div>

            <button type="button" class="lc-submit" onclick="showPanel('panelLogin')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                    <polyline points="10 17 15 12 10 7"/>
                    <line x1="15" y1="12" x2="3" y2="12"/>
                </svg>
                Sign in now
            </button>

        </div>

    </div>
</div>

<script>
    function showPanel(id) {
        document.querySelectorAll('.rp-panel').forEach(p => p.classList.remove('active'));
        document.getElementById(id).classList.add('active');
    }

    const eyeOpen   = `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`;
    const eyeClosed = `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>`;
    const checkSvg  = `<polyline points="20 6 9 17 4 12"/>`;
    const crossSvg  = `<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>`;

    function togglePassword(fieldId, iconId) {
        const input = document.getElementById(fieldId);
        const icon  = document.getElementById(iconId);
        const hidden = input.type === 'password';
        input.type     = hidden ? 'text' : 'password';
        icon.innerHTML = hidden ? eyeClosed : eyeOpen;
    }

    let verifiedUsername = '';

    async function verifyUsername() {
        const username = document.getElementById('resetUsername').value.trim();
        const errorDiv = document.getElementById('step1Error');
        errorDiv.innerHTML = '';

        if (!username) {
            showAlert(errorDiv, 'error', 'Please enter your username.');
            return;
        }

        try {
            const resp = await fetch('/Home/CheckUsername', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username })
            });
            const data = await resp.json();
            if (data.exists) {
                verifiedUsername = username;
                showPanel('panelForgotStep2');
            } else {
                showAlert(errorDiv, 'error', 'Username not found. Please check and try again.');
            }
        } catch {
            showAlert(errorDiv, 'error', 'Something went wrong. Please try again.');
        }
    }

    const pwdRules = {
        'r-case':    v => /[A-Z]/.test(v) && /[a-z]/.test(v),
        'r-num':     v => /[0-9]/.test(v),
        'r-special': v => /[!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?`~]/.test(v),
        'r-len':     v => v.length >= 8
    };

    const ruleIcons = {
        'r-case': 'ri-case', 'r-num': 'ri-num',
        'r-special': 'ri-special', 'r-len': 'ri-len'
    };

    function setRule(ruleId, met, dirty) {
        const row  = document.getElementById(ruleId);
        const icon = document.getElementById(ruleIcons[ruleId]);
        if (!dirty) {
            row.className = 'lc-rule';
            icon.innerHTML = checkSvg;
            icon.setAttribute('stroke', '#d1d5db');
            return;
        }
        row.className  = met ? 'lc-rule met' : 'lc-rule fail';
        icon.innerHTML = met ? checkSvg : crossSvg;
        icon.setAttribute('stroke', met ? '#22c55e' : '#ef4444');
    }

    function onNewPasswordInput(val) {
        const dirty = val.length > 0;
        Object.entries(pwdRules).forEach(([id, fn]) => setRule(id, fn(val), dirty));
        const confirm = document.getElementById('confirmNewPassword').value;
        if (confirm.length > 0) onConfirmNewInput(confirm);
        updateResetBtn();
    }

    function onConfirmNewInput(val) {
        const pass  = document.getElementById('newPassword').value;
        const hint  = document.getElementById('matchHint');
        const input = document.getElementById('confirmNewPassword');
        if (!val) {
            hint.textContent = '';
            hint.className = 'lc-match-hint';
            input.style.borderColor = '';
            return;
        }
        const match = pass === val;
        hint.textContent        = match ? 'Passwords match' : 'Passwords do not match';
        hint.className          = match ? 'lc-match-hint ok' : 'lc-match-hint fail';
        input.style.borderColor = match ? '#22c55e' : '#ef4444';
        updateResetBtn();
    }

    function updateResetBtn() {
        const pass    = document.getElementById('newPassword').value;
        const confirm = document.getElementById('confirmNewPassword').value;
        const allMet  = Object.values(pwdRules).every(fn => fn(pass));
        const matched = pass === confirm && confirm.length > 0;
        document.getElementById('resetSubmitBtn').disabled = !(allMet && matched);
    }

    async function submitReset() {
        const newPassword = document.getElementById('newPassword').value;
        const errorDiv    = document.getElementById('step2Error');
        errorDiv.innerHTML = '';

        try {
            const resp = await fetch('/Home/ResetPassword', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username: verifiedUsername, newPassword })
            });
            const data = await resp.json();
            if (data.success) {
                showPanel('panelForgotDone');
            } else {
                showAlert(errorDiv, 'error', data.message || 'Reset failed. Please try again.');
            }
        } catch {
            showAlert(errorDiv, 'error', 'Something went wrong. Please try again.');
        }
    }

    function showAlert(container, type, message) {
        const icons = {
            error:   `<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>`,
            success: `<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>`,
            info:    `<circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>`
        };
        container.innerHTML = `
            <div class="lc-alert ${type}" style="margin-bottom:1rem;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">${icons[type]}</svg>
                ${message}
            </div>`;
    }
</script>

</body>
</html>