@{
    ViewData["Title"] = "Home";
    var username = Context.Session.GetString("username") ?? "there";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap');

    .dash-root {
        font-family: 'DM Sans', sans-serif;
        max-width: 960px;
        margin: 0 auto;
        padding: 2rem 0 3rem;
    }

    /* ── WELCOME BANNER ── */
    .dash-welcome {
        background: #1e3a5f;
        border-radius: 16px;
        padding: 2rem 2.5rem;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

        .dash-welcome::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px);
            background-size: 22px 22px;
            pointer-events: none;
        }

        .dash-welcome::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(96,165,250,0.12) 0%, transparent 70%);
            right: -60px;
            top: -80px;
            pointer-events: none;
        }

    .dash-welcome-text {
        position: relative;
        z-index: 1;
    }

    .dash-welcome-greeting {
        font-size: 13px;
        color: #93c5fd;
        font-family: 'DM Mono', monospace;
        margin: 0 0 6px;
        letter-spacing: 0.3px;
    }

    .dash-welcome-title {
        font-size: 24px;
        font-weight: 600;
        color: #ffffff;
        margin: 0 0 6px;
        letter-spacing: -0.3px;
    }

    .dash-welcome-sub {
        font-size: 13.5px;
        color: #93adc8;
        margin: 0;
    }

    .dash-welcome-date {
        position: relative;
        z-index: 1;
        text-align: right;
        flex-shrink: 0;
    }

    .dash-date-day {
        font-size: 36px;
        font-weight: 600;
        color: #ffffff;
        font-family: 'DM Mono', monospace;
        line-height: 1;
        margin: 0;
    }

    .dash-date-label {
        font-size: 12px;
        color: #93adc8;
        margin: 4px 0 0;
        font-family: 'DM Mono', monospace;
    }

    /* ── QUICK LINKS ── */
    .dash-section-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.1px;
        text-transform: uppercase;
        color: #9ca3af;
        margin: 0 0 0.75rem;
    }

    .dash-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 12px;
        margin-bottom: 2rem;
    }

    .dash-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 13px;
        padding: 1.25rem 1.5rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.15s;
        display: flex;
        flex-direction: column;
        gap: 10px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        cursor: pointer;
    }

        .dash-card:hover {
            border-color: #c7d7ed;
            box-shadow: 0 4px 16px rgba(30,58,95,0.08);
            transform: translateY(-1px);
            text-decoration: none;
            color: inherit;
        }

    .dash-card-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .dash-card-icon svg {
            width: 18px;
            height: 18px;
        }

        .dash-card-icon.blue {
            background: #E6F1FB;
            color: #1e3a5f;
        }

        .dash-card-icon.green {
            background: #EAF3DE;
            color: #3B6D11;
        }

        .dash-card-icon.amber {
            background: #FEF3C7;
            color: #92400e;
        }

        .dash-card-icon.purple {
            background: #EDE9FE;
            color: #5b21b6;
        }

        .dash-card-icon.red {
            background: #FCEBEB;
            color: #A32D2D;
        }

        .dash-card-icon.teal {
            background: #CCFBF1;
            color: #0f766e;
        }

    .dash-card-title {
        font-size: 14px;
        font-weight: 600;
        color: #111827;
        margin: 0 0 2px;
    }

    .dash-card-sub {
        font-size: 12px;
        color: #9ca3af;
        margin: 0;
    }

    .dash-card-arrow {
        margin-top: auto;
        font-size: 11px;
        color: #d1d5db;
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .dash-card-arrow svg {
            width: 12px;
            height: 12px;
        }

    /* ── COMING SOON BADGE ── */
    .dash-soon {
        font-size: 10px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 10px;
        background: #f3f4f6;
        color: #9ca3af;
        border: 1px solid #e5e7eb;
        letter-spacing: 0.4px;
        margin-top: auto;
        align-self: flex-start;
    }

    @@media (max-width: 640px) {
        .dash-welcome {
            flex-direction: column;
            align-items: flex-start;
            padding: 1.5rem;
        }

        .dash-welcome-date {
            text-align: left;
        }

        .dash-cards {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="dash-root">

    <!-- ── WELCOME BANNER ── -->
    <div class="dash-welcome">
        <div class="dash-welcome-text">
            <p class="dash-welcome-greeting">Good @(DateTime.Now.Hour < 12 ? "morning" : DateTime.Now.Hour < 17 ? "afternoon" : "evening") ☀</p>
            <h1 class="dash-welcome-title">Welcome, @username!</h1>
            <p class="dash-welcome-sub">Here's your employee dashboard. More features coming soon.</p>
        </div>
        <div class="dash-welcome-date">
            <p class="dash-date-day">@DateTime.Now.ToString("dd")</p>
            <p class="dash-date-label">@DateTime.Now.ToString("MMM yyyy")</p>
        </div>
    </div>

    <!-- ── QUICK ACCESS ── -->
    <p class="dash-section-label">Quick access</p>
    <div class="dash-cards">

        <a class="dash-card" asp-controller="Home" asp-action="Status">
            <div class="dash-card-icon blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
            </div>
            <div>
                <p class="dash-card-title">Daily Status</p>
                <p class="dash-card-sub">Log your work updates</p>
            </div>
            <div class="dash-card-arrow">
                Go <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg>
            </div>
        </a>

        <a class="dash-card" asp-controller="Home" asp-action="EmployeeProfile">
            <div class="dash-card-icon green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
                </svg>
            </div>
            <div>
                <p class="dash-card-title">My Profile</p>
                <p class="dash-card-sub">View & edit your details</p>
            </div>
            <div class="dash-card-arrow">
                Go <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg>
            </div>
        </a>

        <div class="dash-card">
            <div class="dash-card-icon amber">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </div>
            <div>
                <p class="dash-card-title">Holidays</p>
                <p class="dash-card-sub">View upcoming holidays</p>
            </div>
            <span class="dash-soon">Coming soon</span>
        </div>

        <div class="dash-card">
            <div class="dash-card-icon purple">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23" />
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
            </div>
            <div>
                <p class="dash-card-title">Salary</p>
                <p class="dash-card-sub">Payslips & breakdown</p>
            </div>
            <span class="dash-soon">Coming soon</span>
        </div>

        <div class="dash-card">
            <div class="dash-card-icon teal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </div>
            <div>
                <p class="dash-card-title">Leaves</p>
                <p class="dash-card-sub">Apply & track leaves</p>
            </div>
            <span class="dash-soon">Coming soon</span>
        </div>

        <div class="dash-card">
            <div class="dash-card-icon red">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="12" y1="18" x2="12" y2="12" />
                    <line x1="9" y1="15" x2="15" y2="15" />
                </svg>
            </div>
            <div>
                <p class="dash-card-title">Raise a Request</p>
                <p class="dash-card-sub">PF, Form 16 & more</p>
            </div>
            <span class="dash-soon">Coming soon</span>
        </div>

    </div>

</div>
